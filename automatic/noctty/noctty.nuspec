<?xml version="1.0" encoding="utf-8"?>
<!-- Read this before creating packages: https://docs.chocolatey.org/en-us/create/create-packages -->
<!-- It is especially important to read the above link to understand additional requirements when publishing packages to the community feed aka dot org (https://community.chocolatey.org/packages). -->

<!-- Test your packages in a test environment: https://github.com/chocolatey-community/chocolatey-test-environment -->

<!--
This is a nuspec. It mostly adheres to https://docs.microsoft.com/en-us/nuget/reference/nuspec. Chocolatey uses a special version of NuGet.Core that allows us to do more than was initially possible. As such there are certain things to be aware of:

* the package xmlns schema url may cause issues with nuget.exe
* Any of the following elements can ONLY be used by choco tools - projectSourceUrl, docsUrl, mailingListUrl, bugTrackerUrl, packageSourceUrl, provides, conflicts, replaces
* nuget.exe can still install packages with those elements but they are ignored. Any authoring tools or commands will error on those elements
-->

<!-- You can embed software files directly into packages, as long as you are not bound by distribution rights. -->
<!-- * If you are an organization making private packages, you probably have no issues here -->
<!-- * If you are releasing to the community feed, you need to consider distribution rights. -->
<!-- Do not remove this test for UTF-8: if “Ω” doesn’t appear as greek uppercase omega letter enclosed in quotation marks, you should use an editor that supports UTF-8, not this one. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <!-- == PACKAGE SPECIFIC SECTION == -->
    <!-- This section is about this package, although id and version have ties back to the software -->
    <!-- id is lowercase and if you want a good separator for words, use '-', not '.'. Dots are only acceptable as suffixes for certain types of packages, e.g. .install, .portable, .extension, .template -->
    <!-- If the software is cross-platform, attempt to use the same id as the debian/rpm package(s) if possible. -->
    <id>noctty</id>
    <!-- version should MATCH as closely as possible with the underlying software -->
    <!-- Is the version a prerelease of a version? https://docs.microsoft.com/en-us/nuget/concepts/package-versioning#creating-prerelease-packages -->
    <!-- Note that unstable versions like 0.0.1 can be considered a released version, but it's possible that one can release a 0.0.1-beta before you release a 0.0.1 version. If the version number is final, that is considered a released version and not a prerelease. -->
    <version>1.3.131</version>
    <!-- owners is a poor name for maintainers of the package. It sticks around by this name for compatibility reasons. It basically means you. -->
    <owners>virtualex</owners>
    <!-- ============================== -->

    <!-- == SOFTWARE SPECIFIC SECTION == -->
    <!-- This section is about the software itself -->
    <title>noctty</title>
    <authors>Aman Thanvi</authors>
    <!-- projectUrl is required for the community feed -->
    <projectUrl>https://noctty.com</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/virtualex-itv/chocolatey-packages@661d4350a9867982cea50dd5d2d64da142cd1e3f/icons/noctty.png</iconUrl>
    <!-- copyright is usually years and software vendor, but not required for internal feeds -->
    <copyright>Copyright (c) 2024 Mitchell Hashimoto, Ghostty contributors</copyright>
    <tags>noctty terminal terminal-emulator ghostty console shell tabs splits powershell cli foss</tags>
    <releaseNotes>https://github.com/amanthanvi/noctty/releases/tag/v1.3.131</releaseNotes>
    <licenseUrl>https://github.com/amanthanvi/noctty/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <packageSourceUrl>https://github.com/virtualex-itv/chocolatey-packages/tree/master/automatic/noctty</packageSourceUrl>
    <projectSourceUrl>https://github.com/amanthanvi/noctty</projectSourceUrl>
    <bugTrackerUrl>https://github.com/amanthanvi/noctty/issues</bugTrackerUrl>
    <docsUrl>https://github.com/amanthanvi/noctty/blob/main/docs/getting-started.md</docsUrl>
    <summary>A native Windows terminal built on Ghostty's terminal core.</summary>
    <description><![CDATA[noctty is a native Win32 terminal emulator for Windows 10 and 11 (x64 and ARM64). It runs Ghostty's terminal core - parsing, fonts, rendering, input and shell integration - inside a native Windows app with its own windowing, tabs, splits, settings window and updater.

### Features

* Tabs and splits, with session restoration of windows, tabs, splits, working directories, profiles and titles
* Per-pane shells: PowerShell, cmd, Git Bash or WSL
* Universal command palette (Ctrl+Shift+P) for actions, tabs, panes, profiles, themes and settings
* Native settings window that only writes the lines you change, or edit %LOCALAPPDATA%\noctty\config.ghostty directly
* No telemetry; the app checks for updates at most once a day and the check can be switched off with auto-update = off

### Package Notes

* The release installer is signed with a self-signed certificate, so Windows SmartScreen may warn on a manual run. This package verifies the download against the SHA-256 published with each release.
* The installer does not add noctty to PATH.
* noctty is independent and not affiliated with the Ghostty project.
* The in-app updater is separate from Chocolatey. Use choco upgrade noctty to keep package metadata in sync.

**Please Note**: This is an automatically updated package. If you find it is out of date by more than a day or two, please contact the maintainer(s) and let them know the package is no longer updating correctly.
]]></description>
    <!-- =============================== -->

    <!-- Specifying dependencies and version ranges? https://docs.microsoft.com/en-us/nuget/concepts/package-versioning#specifying-version-ranges-in-.nuspec-files -->
    <!--<dependencies>
      <dependency id="" version="__MINIMUM_VERSION__" />
      <dependency id="" version="[__EXACT_VERSION__]" />
      <dependency id="" version="[_MIN_VERSION_INCLUSIVE, MAX_VERSION_INCLUSIVE]" />
      <dependency id="" version="[_MIN_VERSION_INCLUSIVE, MAX_VERSION_EXCLUSIVE)" />
      <dependency id="" />
    </dependencies>-->

    <!--<provides>NOT YET IMPLEMENTED</provides>-->
    <!--<conflicts>NOT YET IMPLEMENTED</conflicts>-->
    <!--<replaces>NOT YET IMPLEMENTED</replaces>-->
  </metadata>
  <!-- this section controls what actually gets packaged into the Chocolatey package -->
  <!-- Uncomment to limit what is packed in -->
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
